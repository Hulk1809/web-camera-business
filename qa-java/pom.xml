<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <groupId>vn.progear.qa</groupId>
  <artifactId>external-qa</artifactId>
  <version>1.0.0-SNAPSHOT</version>
  <name>Pro Gear external seven-layer QA</name>

  <properties>
    <maven.compiler.release>21</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <junit.version>5.14.4</junit.version>
    <rest.assured.version>6.2.0</rest.assured.version>
    <selenium.version>4.51.0</selenium.version>
    <surefire.version>3.5.2</surefire.version>
    <qa.tags>layer1 | layer2 | layer3 | layer4 | layer5 | layer6 | layer7</qa.tags>
  </properties>

  <dependencies>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <version>${junit.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>io.rest-assured</groupId>
      <artifactId>rest-assured</artifactId>
      <version>${rest.assured.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.seleniumhq.selenium</groupId>
      <artifactId>selenium-java</artifactId>
      <version>${selenium.version}</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>3.13.0</version>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>${surefire.version}</version>
        <configuration>
          <groups>${qa.tags}</groups>
          <failIfNoTests>true</failIfNoTests>
          <reportsDirectory>${project.build.directory}/reports/junit</reportsDirectory>
          <systemPropertyVariables>
            <java.awt.headless>true</java.awt.headless>
          </systemPropertyVariables>
        </configuration>
      </plugin>
    </plugins>
  </build>

  <profiles>
    <profile><id>layer1</id><properties><qa.tags>layer1</qa.tags></properties></profile>
    <profile><id>layer2</id><properties><qa.tags>layer2</qa.tags></properties></profile>
    <profile><id>layer3</id><properties><qa.tags>layer3</qa.tags></properties></profile>
    <profile><id>layer4</id><properties><qa.tags>layer4</qa.tags></properties></profile>
    <profile><id>layer5</id><properties><qa.tags>layer5</qa.tags></properties></profile>
    <profile><id>layer6</id><properties><qa.tags>layer6</qa.tags></properties></profile>
    <profile><id>layer7</id><properties><qa.tags>layer7</qa.tags></properties></profile>
    <profile><id>read-only</id><properties><qa.tags>layer1 | layer2 | layer3 | layer4 | layer5 | layer6 | layer7</qa.tags></properties></profile>
    <profile><id>ephemeral-browser</id><properties><qa.tags>ephemeral-writes</qa.tags></properties></profile>
  </profiles>
</project>
